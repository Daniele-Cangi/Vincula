+#include "common/ManagedSession.h"
+#include <QDir>
+#include <QFile>
+#include <QElapsedTimer>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QTemporaryDir>
+#include <QTest>
+#include <stdexcept>
+#include <algorithm>
+#ifdef Q_OS_WIN
+#include <windows.h>
+#include <aclapi.h>
+#include <sddl.h>
+#else
+#include <poll.h>
+#include <unistd.h>
+#endif
+
+using deskflow::ManagedSession;
+namespace {
+const QString a = "11111111-1111-4111-8111-111111111111";
+const QString b = "22222222-2222-4222-8222-222222222222";
+const QString c = "33333333-3333-4333-8333-333333333333";
+const QString pinA(64, 'a'), pinB(64, 'b'), pinC(64, 'c');
+QJsonObject bootstrap(bool clipboard = true, bool primary = true)
+{
+  const auto root = QDir::tempPath() + "/managed-fixture";
+  return {{"type", "bootstrap"}, {"protocol", 1}, {"session_id", "99999999-9999-4999-8999-999999999999"},
+          {"node_id", primary ? a : b}, {"primary", a}, {"engine_nonce", QString(64, 'd')},
+          {"manifest_sha256", QString(64, 'e')}, {"settings_file", root + "/Deskflow.conf"},
+          {"state_file", root + "/Deskflow.state"}, {"clipboard", clipboard},
+          {"members", QJsonArray{a, b, c}}, {"tls_pins", QJsonObject{{a, pinA}, {b, pinB}, {c, pinC}}},
+          {"owner_consent", true}};
+}
+QJsonObject state(ManagedSession &s) { return s.snapshot(QString(64, 'f')); }
+void protectFixture(const QString &path)
+{
+#ifdef Q_OS_WIN
+  HANDLE token = nullptr;
+  if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) throw std::runtime_error("fixture token failed");
+  DWORD length = 0; GetTokenInformation(token, TokenUser, nullptr, 0, &length);
+  QByteArray user(int(length), '\0');
+  const auto ok = GetTokenInformation(token, TokenUser, user.data(), length, &length); CloseHandle(token);
+  if (!ok) throw std::runtime_error("fixture owner failed");
+  wchar_t *sid = nullptr;
+  if (!ConvertSidToStringSidW(reinterpret_cast<TOKEN_USER *>(user.data())->User.Sid, &sid)) throw std::runtime_error("fixture SID failed");
+  const auto sddl = QString("D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;FA;;;%1)").arg(QString::fromWCharArray(sid)).toStdWString();
+  LocalFree(sid);
+  PSECURITY_DESCRIPTOR descriptor = nullptr;
+  if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl.c_str(), SDDL_REVISION_1, &descriptor, nullptr)) throw std::runtime_error("fixture ACL failed");
+  PACL acl = nullptr; BOOL present = false, defaulted = false;
+  const auto pathW = path.toStdWString();
+  const auto valid = GetSecurityDescriptorDacl(descriptor, &present, &acl, &defaulted);
+  const auto result = valid && present && acl
+      ? SetNamedSecurityInfoW(const_cast<wchar_t *>(pathW.c_str()), SE_FILE_OBJECT,
+          DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION, nullptr, nullptr, acl, nullptr)
+      : ERROR_INVALID_ACL;
+  LocalFree(descriptor);
+  if (result != ERROR_SUCCESS) throw std::runtime_error("fixture ACL protection failed");
+#else
+  if (!QFile::setPermissions(path, QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner))
+    throw std::runtime_error("fixture permissions failed");
+#endif
+}
+void windowsReady(ManagedSession &s)
+{
+  s.graphics("windows"); s.fact("windows_enabled", true); s.fact("windows_hook", true); s.fact("windows_desktop", true);
+}
+}
+
+class ManagedSessionTests : public QObject
+{
+  Q_OBJECT
+private Q_SLOTS:
+  void canonicalPythonInterop();
+  void rejectsAmbiguousJson();
+  void validatesExactBootstrap();
+  void bindsCertificateToExactUuid();
+  void preservesStarTopology();
+  void latchesBackendRevocation();
+  void ignoresStrangerDisconnection();
+  void neverClaimsDisabledClipboardReady();
+  void requiresActualWaylandFacts();
+  void provisionIsExclusiveAndSessionSpecific();
+  void privateControlBindsChallengeAndStops();
+  void privateControlRejectsAmbiguousRequest();
+  void privateBootstrapRejectsAnotherSessionCertificate();
+  void privateControlRequiresLiveBackendLoop();
+};
+
+void ManagedSessionTests::canonicalPythonInterop()
+{
+  // Produced with Python sort_keys=True, ensure_ascii=False, compact separators.
+  const auto raw = QByteArray::fromHex("7b2261223a22433a5c5c55736572735c5c41646d696e5c5c56696e63756c615c5cc3a820f09f9880205c22715c222f78222c2262223a312c227a223a22e99baa227d");
+  const auto object = ManagedSession::parseCanonical(raw);
+  QCOMPARE(object.value("a").toString(), QString::fromUtf8("C:\\Users\\Admin\\Vincula\\è 😀 \"q\"/x"));
+  QCOMPARE(object.value("z").toString(), QString::fromUtf8("雪"));
+  QCOMPARE(QJsonDocument(object).toJson(QJsonDocument::Compact), raw);
+}
+void ManagedSessionTests::rejectsAmbiguousJson()
+{
+  for (const auto raw : {QByteArray("{\"type\":\"stop\",\"type\":\"stop\"}"), QByteArray("{ \"type\": \"stop\" }"),
+                         QByteArray("[]"), QByteArray("{\"protocol\":NaN}"), QByteArray("{\"protocol\":1.0}")})
+    QVERIFY_EXCEPTION_THROWN(ManagedSession::parseCanonical(raw), std::runtime_error);
+}
+void ManagedSessionTests::validatesExactBootstrap()
+{
+  auto value = bootstrap(); ManagedSession::validateBootstrap(value);
+  value.insert("owner_consent", false);
+  QVERIFY_EXCEPTION_THROWN(ManagedSession::validateBootstrap(value), std::runtime_error);
+  value = bootstrap(); value.insert("extra", true);
+  QVERIFY_EXCEPTION_THROWN(ManagedSession::validateBootstrap(value), std::runtime_error);
+  value = bootstrap(); value.insert("protocol", true);
+  QVERIFY_EXCEPTION_THROWN(ManagedSession::validateBootstrap(value), std::runtime_error);
+  value = bootstrap(); auto pins = value.value("tls_pins").toObject(); pins[b] = pinA; value["tls_pins"] = pins;
+  QVERIFY_EXCEPTION_THROWN(ManagedSession::validateBootstrap(value), std::runtime_error);
+  value = bootstrap(); value["members"] = QJsonArray{a, b, b};
+  QVERIFY_EXCEPTION_THROWN(ManagedSession::validateBootstrap(value), std::runtime_error);
+}
+void ManagedSessionTests::bindsCertificateToExactUuid()
+{
+  ManagedSession s; s.load(bootstrap());
+  QVERIFY(s.allowsPeer("vincula-" + b, pinB));
+  QVERIFY(!s.allowsPeer("vincula-" + b, pinC));
+  QVERIFY(!s.allowsPeer(b, pinB));
+  QVERIFY(!s.allowsPeer("vincula-" + a, pinA));
+  QVERIFY(s.peerReady("vincula-" + b, pinB));
+  QVERIFY(!s.peerReady("vincula-" + b, pinB));
+  QCOMPARE(state(s)["peers"].toArray().size(), 1);
+  QVERIFY(!state(s)["revoked"].toBool());
+}
+void ManagedSessionTests::preservesStarTopology()
+{
+  ManagedSession s; s.load(bootstrap(true, false));
+  QVERIFY(s.peerReady("vincula-" + a, pinA));
+  QVERIFY(!s.peerReady("vincula-" + c, pinC));
+  QCOMPARE(state(s)["peers"].toArray().size(), 1);
+  const auto first = state(s), second = state(s);
+  QVERIFY(second["sequence"].toInteger() > first["sequence"].toInteger());
+  QCOMPARE(first["manifest_sha256"], QJsonValue(QString(64, 'e')));
+}
+void ManagedSessionTests::latchesBackendRevocation()
+{
+  ManagedSession s; s.load(bootstrap()); windowsReady(s); s.fact("clipboard_provider", true);
+  QVERIFY(state(s)["input_ready"].toBool()); QVERIFY(state(s)["clipboard_ready"].toBool());
+  s.fact("windows_hook", false); s.fact("windows_hook", true);
+  QVERIFY(state(s)["revoked"].toBool()); QVERIFY(!state(s)["input_ready"].toBool());
+  QVERIFY(!s.peerReady("vincula-" + b, pinB));
+}
+void ManagedSessionTests::ignoresStrangerDisconnection()
+{
+  ManagedSession s; s.load(bootstrap());
+  QVERIFY(s.peerReady("vincula-" + b, pinB));
+  s.peerDisconnected("vincula-" + c); QVERIFY(!state(s)["revoked"].toBool());
+  s.peerDisconnected("vincula-" + b); QVERIFY(state(s)["revoked"].toBool());
+}
+void ManagedSessionTests::neverClaimsDisabledClipboardReady()
+{
+  ManagedSession s; s.load(bootstrap(false)); windowsReady(s);
+  s.fact("clipboard_provider", true); QVERIFY(!state(s)["clipboard_ready"].toBool());
+  s.fact("clipboard_provider", false); QVERIFY(!state(s)["revoked"].toBool());
+  QVERIFY(state(s)["input_ready"].toBool());
+}
+void ManagedSessionTests::requiresActualWaylandFacts()
+{
+  ManagedSession s; s.load(bootstrap(true, false)); s.graphics("wayland");
+  for (const auto key : {"portal_started", "portal_keyboard", "portal_pointer", "eis_setup", "eis_connected", "eis_devices", "eis_enabled"})
+    s.fact(key, true);
+  QVERIFY(state(s)["input_ready"].toBool()); QVERIFY(!state(s)["clipboard_ready"].toBool());
+  s.fact("clipboard_provider", true); s.fact("portal_clipboard", true); QVERIFY(state(s)["clipboard_ready"].toBool());
+  s.fact("eis_devices", false); s.fact("eis_devices", true); QVERIFY(state(s)["revoked"].toBool());
+}
+void ManagedSessionTests::provisionIsExclusiveAndSessionSpecific()
+{
+  QTemporaryDir first, second;
+  QVERIFY(first.isValid() && second.isValid());
+  protectFixture(first.path()); protectFixture(second.path());
+  const auto session = "99999999-9999-4999-8999-999999999999";
+  QCOMPARE(ManagedSession::provision(first.path(), session, a), 0);
+  QCOMPARE(ManagedSession::provision(second.path(), session, a), 0);
+  QVERIFY(ManagedSession::certificateFingerprint(first.path() + "/tls/identity.pem")
+          != ManagedSession::certificateFingerprint(second.path() + "/tls/identity.pem"));
+  QVERIFY_EXCEPTION_THROWN(ManagedSession::provision(first.path(), session, a), std::runtime_error);
+#ifndef Q_OS_WIN
+  const auto path = first.path() + "/tls/identity.pem";
+  QCOMPARE(QFileInfo(path).permissions() & (QFileDevice::ReadGroup | QFileDevice::ReadOther | QFileDevice::WriteGroup | QFileDevice::WriteOther), QFileDevice::Permissions{});
+#endif
+}
