+#else
+#include <fcntl.h>
+#include <poll.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace deskflow {
+namespace {
+constexpr qsizetype kLimit = 65536;
+void require(bool ok, const char *message)
+{
+  if (!ok) throw std::runtime_error(message);
+}
+bool keys(const QJsonObject &o, std::initializer_list<const char *> expected)
+{
+  QSet<QString> names;
+  for (const auto name : expected) names.insert(QString::fromLatin1(name));
+  const auto actual = o.keys();
+  return QSet<QString>(actual.begin(), actual.end()) == names;
+}
+#ifdef Q_OS_WIN
+void windowsPrivateAcl(const QString &path)
+{
+  const auto wide = path.toStdWString();
+  const auto attributes = GetFileAttributesW(wide.c_str());
+  require(attributes != INVALID_FILE_ATTRIBUTES && !(attributes & FILE_ATTRIBUTE_REPARSE_POINT),
+          "managed profile is a reparse point");
+  HANDLE token = nullptr;
+  require(OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token), "cannot inspect managed owner");
+  DWORD size = 0; GetTokenInformation(token, TokenUser, nullptr, 0, &size);
+  QByteArray data(int(size), '\0');
+  const auto tokenOk = GetTokenInformation(token, TokenUser, data.data(), size, &size);
+  CloseHandle(token); require(tokenOk, "cannot inspect managed owner");
+  const auto user = reinterpret_cast<TOKEN_USER *>(data.data())->User.Sid;
+  BYTE systemStorage[SECURITY_MAX_SID_SIZE], adminStorage[SECURITY_MAX_SID_SIZE];
+  DWORD systemSize = sizeof(systemStorage), adminSize = sizeof(adminStorage);
+  require(CreateWellKnownSid(WinLocalSystemSid, nullptr, systemStorage, &systemSize)
+          && CreateWellKnownSid(WinBuiltinAdministratorsSid, nullptr, adminStorage, &adminSize), "cannot inspect managed trustees");
+  PACL acl = nullptr; PSID owner = nullptr; PSECURITY_DESCRIPTOR descriptor = nullptr;
+  require(GetNamedSecurityInfoW(const_cast<wchar_t *>(wide.c_str()), SE_FILE_OBJECT,
+          OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION, &owner, nullptr, &acl, nullptr, &descriptor) == ERROR_SUCCESS,
+          "cannot inspect managed profile ACL");
+  bool safe = owner && acl && (EqualSid(owner, user) || EqualSid(owner, adminStorage) || EqualSid(owner, systemStorage));
+  if (acl) for (DWORD i = 0; i < acl->AceCount; ++i) {
+    void *raw = nullptr; if (!GetAce(acl, i, &raw)) { safe = false; break; }
+    const auto header = static_cast<ACE_HEADER *>(raw);
+    if (header->AceType == ACCESS_DENIED_ACE_TYPE) continue;
+    if (header->AceType != ACCESS_ALLOWED_ACE_TYPE) { safe = false; break; }
+    const auto ace = static_cast<ACCESS_ALLOWED_ACE *>(raw);
+    const auto sid = reinterpret_cast<PSID>(const_cast<DWORD *>(&ace->SidStart));
+    if (ace->Mask && !(EqualSid(sid, user) || EqualSid(sid, adminStorage) || EqualSid(sid, systemStorage))) safe = false;
+  }
+  LocalFree(descriptor); require(safe, "managed profile ACL grants another account access");
+}
+#endif
+void privateFile(const QString &path)
+{
+  const QFileInfo info(path);
+  require(info.exists() && info.isFile() && !info.isSymLink(), "managed file is not regular");
+#ifdef Q_OS_WIN
+  windowsPrivateAcl(path);
+  const auto name = path.toStdWString();
+  const auto handle = CreateFileW(name.c_str(), FILE_READ_ATTRIBUTES, FILE_SHARE_READ, nullptr,
+                                  OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+  require(handle != INVALID_HANDLE_VALUE, "cannot inspect managed file identity");
+  BY_HANDLE_FILE_INFORMATION metadata{};
+  const auto ok = GetFileInformationByHandle(handle, &metadata); CloseHandle(handle);
+  require(ok && metadata.nNumberOfLinks == 1 && !(metadata.dwFileAttributes & (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY)),
+          "managed file is linked or not regular");
+#else
+  struct stat item{};
+  const auto name = QFile::encodeName(path);
+  require(lstat(name.constData(), &item) == 0 && S_ISREG(item.st_mode) && item.st_uid == getuid()
+          && item.st_nlink == 1 && !(item.st_mode & 0077), "managed file is not private");
+#endif
+}
+QString certificatePin(const QString &path, const QString &session = {}, const QString &node = {})
+{
+  QFile file(path);
+  require(file.open(QIODevice::ReadOnly), "cannot open managed certificate");
+  auto bytes = file.read(1024 * 1024 + 1);
+  require(bytes.size() <= 1024 * 1024, "managed certificate is too large");
+  auto bio = std::unique_ptr<BIO, decltype(&BIO_free)>(BIO_new_mem_buf(bytes.constData(), int(bytes.size())), BIO_free);
+  auto cert = std::unique_ptr<X509, decltype(&X509_free)>(PEM_read_bio_X509(bio.get(), nullptr, nullptr, nullptr), X509_free);
+  require(bool(cert), "cannot parse managed certificate");
+  if (!session.isEmpty()) {
+    const auto subject = X509_get_subject_name(cert.get());
+    const auto field = [subject](int nid) {
+      const auto index = X509_NAME_get_index_by_NID(subject, nid, -1);
+      require(index >= 0 && X509_NAME_get_index_by_NID(subject, nid, index) < 0, "ambiguous managed certificate identity");
+      const auto text = X509_NAME_ENTRY_get_data(X509_NAME_get_entry(subject, index));
+      return QString::fromLatin1(reinterpret_cast<const char *>(ASN1_STRING_get0_data(text)), ASN1_STRING_length(text));
+    };
+    require(field(NID_commonName) == node && field(NID_organizationalUnitName) == session,
+            "managed certificate belongs to another session or node");
+  }
+  unsigned char digest[EVP_MAX_MD_SIZE];
+  unsigned int length = 0;
+  require(X509_digest(cert.get(), EVP_sha256(), digest, &length) == 1 && length == 32,
+          "cannot fingerprint managed certificate");
+  return QByteArray(reinterpret_cast<const char *>(digest), int(length)).toHex();
+}
+}
+
+ManagedSession::~ManagedSession() { shutdown(); }
+ManagedSession &ManagedSession::instance() { static ManagedSession value; return value; }
+bool ManagedSession::canonicalUuid(const QString &v)
+{
+  static const QRegularExpression pattern("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$");
+  return pattern.match(v).hasMatch() && QUuid(v).toString(QUuid::WithoutBraces) == v;
+}
+bool ManagedSession::hexDigest(const QString &v)
+{
+  static const QRegularExpression pattern("^[0-9a-f]{64}$");
+  return pattern.match(v).hasMatch();
+}
+QJsonObject ManagedSession::parseCanonical(const QByteArray &raw)
+{
+  require(!raw.isEmpty() && raw.size() <= kLimit, "managed frame size is invalid");
+  QJsonParseError error;
+  const auto doc = QJsonDocument::fromJson(raw, &error);
+  require(error.error == QJsonParseError::NoError && doc.isObject()
+          && doc.toJson(QJsonDocument::Compact) == raw, "managed JSON must be canonical UTF-8");
+  return doc.object();
+}
+void ManagedSession::validateBootstrap(const QJsonObject &o)
+{
+  require(keys(o, {"type", "protocol", "session_id", "node_id", "primary", "engine_nonce", "manifest_sha256",
+                   "settings_file", "state_file", "clipboard", "members", "tls_pins", "owner_consent"}),
+          "managed bootstrap fields are invalid");
+  require(o.value("type") == "bootstrap" && o.value("protocol").isDouble() && o.value("protocol").toDouble() == 1,
+          "managed protocol is unsupported");
+  for (const auto field : {"session_id", "node_id", "primary"})
+    require(o.value(field).isString() && canonicalUuid(o.value(field).toString()), "managed UUID is invalid");
+  require(o.value("engine_nonce").isString() && hexDigest(o.value("engine_nonce").toString())
+          && o.value("manifest_sha256").isString() && hexDigest(o.value("manifest_sha256").toString()),
+          "managed nonce or manifest digest is invalid");
+  require(o.value("clipboard").isBool() && o.value("owner_consent").isBool() && o.value("owner_consent").toBool(),
+          "managed owner consent is required");
+  require(o.value("members").isArray() && o.value("tls_pins").isObject(), "managed member maps are invalid");
+  const auto members = o.value("members").toArray();
+  const auto pins = o.value("tls_pins").toObject();
+  require(members.size() >= 2 && members.size() <= 64 && pins.size() == members.size(), "managed group size is invalid");
+  QSet<QString> ids, fingerprints;
+  for (const auto member : members) {
+    const auto id = member.toString();
+    require(member.isString() && canonicalUuid(id) && !ids.contains(id) && pins.value(id).isString(),
+            "managed member is invalid");
+    const auto pin = pins.value(id).toString();
+    require(hexDigest(pin) && !fingerprints.contains(pin), "managed pins must be distinct");
+    ids.insert(id); fingerprints.insert(pin);
+  }
+  require(ids.contains(o.value("node_id").toString()) && ids.contains(o.value("primary").toString()),
+          "managed group omits local or primary node");
+  const auto settings = o.value("settings_file").toString();
+  const auto state = o.value("state_file").toString();
+  require(o.value("settings_file").isString() && o.value("state_file").isString()
+          && QDir::isAbsolutePath(settings) && QDir::isAbsolutePath(state) && settings != state
+          && QFileInfo(settings).absolutePath() == QFileInfo(state).absolutePath(), "managed paths are invalid");
+  for (const auto &path : {settings, state})
+    require(!path.contains(QChar::Null) && QDir::cleanPath(QDir::fromNativeSeparators(path)) == QDir::fromNativeSeparators(path), "managed paths must be canonical");
+}
+void ManagedSession::load(const QJsonObject &o)
+{
+  validateBootstrap(o);
+  require(!m_active, "managed identity cannot be replaced");
+  m_bootstrap = o; m_primary = o.value("node_id") == o.value("primary"); m_clipboard = o.value("clipboard").toBool();
+  const auto pins = o.value("tls_pins").toObject();
+  for (auto it = pins.begin(); it != pins.end(); ++it)
+    if (it.key() != localNode() && (m_primary || it.key() == primaryNode())) m_expected.insert(it.key(), it.value().toString());
+  m_localPin = pins.value(localNode()).toString();
+  m_active = true;
+}
+QString ManagedSession::profileRoot() const { return QFileInfo(settingsFile()).absolutePath(); }
+QString ManagedSession::certificateFile() const { return profileRoot() + "/tls/identity.pem"; }
+QString ManagedSession::certificateFingerprint(const QString &path) { privateFile(path); return certificatePin(path); }
+
+void ManagedSession::privateDirectory(const QString &path)
+{
+  const QFileInfo info(path);
+  require(QDir::isAbsolutePath(path) && QDir::cleanPath(QDir::fromNativeSeparators(path)) == QDir::fromNativeSeparators(path) && info.isDir() && !info.isSymLink(),
+          "managed profile directory is invalid");
+#ifdef Q_OS_WIN
+  windowsPrivateAcl(path);
+#else
+  struct stat item{}; const auto name = QFile::encodeName(path);
+  require(lstat(name.constData(), &item) == 0 && S_ISDIR(item.st_mode) && item.st_uid == getuid()
+          && !(item.st_mode & 0077), "managed profile directory is not private");
+#endif
+  // Every existing ancestor must remain a real directory. The leaf's protected
+  // permissions prevent traversal into the private session by another account.
+  auto parent = info.absoluteDir();
+  do {
+    require(!QFileInfo(parent.absolutePath()).isSymLink(), "managed ancestor is a symlink");
+#ifdef Q_OS_WIN
+    const auto wide = parent.absolutePath().toStdWString();
+    const auto attributes = GetFileAttributesW(wide.c_str());
+    require(attributes != INVALID_FILE_ATTRIBUTES && !(attributes & FILE_ATTRIBUTE_REPARSE_POINT), "managed ancestor is a reparse point");
+#endif
+  } while (parent.cdUp());
+}
+
+int ManagedSession::provision(const QString &directory, const QString &session, const QString &node)
+{
+  require(canonicalUuid(session) && canonicalUuid(node), "provision identity is invalid");
+  privateDirectory(directory);
+  const auto tls = directory + "/tls";
+  require(!QFileInfo::exists(tls) && QDir().mkdir(tls), "provision TLS directory already exists");
+#ifndef Q_OS_WIN
+  require(QFile::setPermissions(tls, QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner), "cannot protect TLS directory");
+#endif
+  privateDirectory(tls);
+  const auto path = tls + "/identity.pem";
+  QFile file(path);
+  require(file.open(QIODevice::WriteOnly | QIODevice::NewOnly, QFileDevice::ReadOwner | QFileDevice::WriteOwner),
+          "provision certificate already exists");
+  auto key = std::unique_ptr<EVP_PKEY, decltype(&EVP_PKEY_free)>(EVP_RSA_gen(2048), EVP_PKEY_free);
+  auto cert = std::unique_ptr<X509, decltype(&X509_free)>(X509_new(), X509_free);
+  require(key && cert, "cannot allocate provision certificate");
+  require(X509_set_version(cert.get(), 2) == 1 && ASN1_INTEGER_set(X509_get_serialNumber(cert.get()), 1) == 1
+          && X509_gmtime_adj(X509_getm_notBefore(cert.get()), -60) && X509_gmtime_adj(X509_getm_notAfter(cert.get()), 86400)
+          && X509_set_pubkey(cert.get(), key.get()) == 1, "cannot construct provision certificate");
+  auto subject = X509_get_subject_name(cert.get());
+  const auto cn = node.toUtf8();
+  const auto ou = session.toUtf8();
+  require(X509_NAME_add_entry_by_txt(subject, "CN", MBSTRING_ASC,
+          reinterpret_cast<const unsigned char *>(cn.constData()), int(cn.size()), -1, 0) == 1
+          && X509_NAME_add_entry_by_txt(subject, "OU", MBSTRING_ASC,
+          reinterpret_cast<const unsigned char *>(ou.constData()), int(ou.size()), -1, 0) == 1
+          && X509_set_issuer_name(cert.get(), subject) == 1 && X509_sign(cert.get(), key.get(), EVP_sha256()) > 0,
+          "cannot sign provision certificate");
+  // Private material exists only in this engine and the exclusive local file.
+  // A memory BIO avoids confusing a Windows HANDLE with a CRT descriptor.
+  auto bio = std::unique_ptr<BIO, decltype(&BIO_free)>(BIO_new(BIO_s_mem()), BIO_free);
+  require(bio && PEM_write_bio_PrivateKey(bio.get(), key.get(), nullptr, nullptr, 0, nullptr, nullptr) == 1
+          && PEM_write_bio_X509(bio.get(), cert.get()) == 1 && BIO_flush(bio.get()) == 1,
+          "cannot publish provision certificate");
+  char *encoded = nullptr;
+  const auto count = BIO_get_mem_data(bio.get(), &encoded);
+  require(count > 0 && file.write(encoded, count) == count && file.flush(), "cannot write provision certificate");
+  OPENSSL_cleanse(encoded, size_t(count));
+  file.close(); privateFile(path);
+  const auto pin = certificatePin(path);
+  const QJsonObject result{{"protocol", 1}, {"session_id", session}, {"node_id", node},
+                           {"fingerprint_sha256", pin}, {"certificate_reference", path}};
+  QTextStream(stdout) << QJsonDocument(result).toJson(QJsonDocument::Compact) << "\n";
+  return 0;
+}
+
+void ManagedSession::validateFiles()
+{
+  privateDirectory(profileRoot()); privateDirectory(profileRoot() + "/tls");
+  privateFile(settingsFile());
+  if (QFileInfo::exists(stateFile())) privateFile(stateFile());
+  privateFile(certificateFile());
+  require(certificatePin(certificateFile(), m_bootstrap.value("session_id").toString(), localNode()) == m_localPin,
+          "managed local certificate differs from enrolled pin");
+}
+bool ManagedSession::initialize(const QStringList &arguments)
+{
+  const auto incoming = arguments.indexOf("--vincula-managed-in"), outgoing = arguments.indexOf("--vincula-managed-out");
+  if (incoming < 0 && outgoing < 0) return false;
+  require(arguments.count("--vincula-managed-in") == 1 && arguments.count("--vincula-managed-out") == 1,
+          "managed pipe selectors may not repeat");
+  require(incoming >= 0 && outgoing >= 0 && incoming + 1 < arguments.size() && outgoing + 1 < arguments.size(), "managed pipe arguments are incomplete");
+  bool a = false, b = false;
+  m_in = qintptr(arguments[incoming + 1].toULongLong(&a)); m_out = qintptr(arguments[outgoing + 1].toULongLong(&b));
+  require(a && b && m_in > 2 && m_out > 2 && m_in != m_out, "managed pipe handles are invalid");
+#ifdef Q_OS_WIN
+  for (auto handle : {m_in, m_out})
+    require(GetFileType(reinterpret_cast<HANDLE>(handle)) == FILE_TYPE_PIPE
+            && SetHandleInformation(reinterpret_cast<HANDLE>(handle), HANDLE_FLAG_INHERIT, 0), "managed handle is not a private pipe");
+#else
+  for (const auto descriptor : {m_in, m_out}) {
+    struct stat item{};
+    require(fstat(int(descriptor), &item) == 0 && S_ISFIFO(item.st_mode)
+            && fcntl(int(descriptor), F_SETFD, FD_CLOEXEC) == 0, "managed descriptor is not a private pipe");
+  }
+#endif
+  load(parseCanonical(readFrame(5000))); validateFiles();
+  // Session profiles are consumed once, including after a crash. A new engine
+  // requires new enrollment and a freshly provisioned local certificate.
+  QFile claim(profileRoot() + "/runtime.claim");
+  require(claim.open(QIODevice::WriteOnly | QIODevice::NewOnly, QFileDevice::ReadOwner | QFileDevice::WriteOwner),
+          "managed profile was already started");
+  const auto identity = QJsonDocument(QJsonObject{{"session_id", m_bootstrap.value("session_id")},
+          {"node_id", localNode()}, {"engine_nonce", m_bootstrap.value("engine_nonce")}}).toJson(QJsonDocument::Compact);
+  require(claim.write(identity) == identity.size() && claim.flush(), "cannot consume managed profile");
+  claim.close(); privateFile(claim.fileName());
+  return true;
+}
+bool ManagedSession::readExact(char *data, qsizetype size, int timeoutMs)
+{
+  QElapsedTimer clock; clock.start(); qsizetype offset = 0;
+  while (offset < size && !m_stopping && clock.elapsed() < timeoutMs) {
+#ifdef Q_OS_WIN
+    DWORD available = 0, count = 0;
+    if (!PeekNamedPipe(reinterpret_cast<HANDLE>(m_in), nullptr, 0, nullptr, &available, nullptr)) return false;
+    if (!available) { std::this_thread::sleep_for(std::chrono::milliseconds(5)); continue; }
+    if (!ReadFile(reinterpret_cast<HANDLE>(m_in), data + offset, DWORD(std::min<qsizetype>(available, size - offset)), &count, nullptr) || !count) return false;
+    offset += count;
+#else
+    pollfd ready{int(m_in), POLLIN, 0}; const auto polled = poll(&ready, 1, 20);
+    if (polled < 0) { if (errno == EINTR) continue; return false; }
+    if (!polled) continue;
+    const auto count = ::read(int(m_in), data + offset, size_t(size - offset));
+    if (count <= 0) { if (count < 0 && errno == EINTR) continue; return false; }
+    offset += count;
+#endif
+  }
+  return offset == size;
+}
+QByteArray ManagedSession::readFrame(int timeoutMs)
+{
+  unsigned char header[4];
+  require(readExact(reinterpret_cast<char *>(header), 4, timeoutMs), "managed input closed or timed out");
+  const auto size = (quint32(header[0]) << 24) | (quint32(header[1]) << 16) | (quint32(header[2]) << 8) | header[3];
+  require(size > 0 && size <= kLimit, "managed input frame is oversized");
+  QByteArray raw(int(size), '\0');
+  require(readExact(raw.data(), size, timeoutMs), "managed input frame was truncated");
+  return raw;
+}
+void ManagedSession::writeFrame(const QJsonObject &object)
+{
+  const auto raw = QJsonDocument(object).toJson(QJsonDocument::Compact);
+  require(!raw.isEmpty() && raw.size() <= kLimit, "managed snapshot is oversized");
+  const auto size = quint32(raw.size());
+  QByteArray frame;
+  for (int shift : {24, 16, 8, 0}) frame.append(char((size >> shift) & 255));
+  frame += raw; qsizetype offset = 0;
+  while (offset < frame.size()) {
+#ifdef Q_OS_WIN
+    DWORD count = 0;
+    require(WriteFile(reinterpret_cast<HANDLE>(m_out), frame.constData() + offset, DWORD(frame.size() - offset), &count, nullptr) && count,
+            "managed output closed");
+#else
+    const auto count = ::write(int(m_out), frame.constData() + offset, size_t(frame.size() - offset));
+    if (count < 0 && errno == EINTR) continue;
+    require(count > 0, "managed output closed");
+#endif
+    offset += count;
+  }
+}
+void ManagedSession::startControl(std::function<void()> quit, std::function<void(quint64)> probe)
+{
+  require(m_active && !m_thread.joinable(), "managed control cannot be restarted");
+  m_quit = std::move(quit); m_probe = std::move(probe); m_loopRequired = bool(m_probe);
+  m_thread = std::thread([this] { control(); });
+  bool revoked = false;
+  { std::scoped_lock lock(m_mutex); revoked = m_revoked; }
+  if (revoked) notifyQuit();
+}
+void ManagedSession::control()
+{
+  try {
+    while (!m_stopping) {
+      const auto object = parseCanonical(readFrame(5000));
+      if (keys(object, {"type"}) && object.value("type") == "stop") { revoke("owner_stop"); return; }
+      require(keys(object, {"type", "challenge"}) && object.value("type") == "snapshot"
+              && object.value("challenge").isString() && hexDigest(object.value("challenge").toString()), "managed request is invalid");
+      probeEventLoop();
+      writeFrame(snapshot(object.value("challenge").toString()));
+    }
+  } catch (const std::exception &) {
+    if (!m_stopping) revoke("control_channel_lost");
+  }
+}
+void ManagedSession::shutdown()
+{
+  m_stopping = true;
+  m_probeCondition.notify_all();
+  if (m_thread.joinable()) m_thread.join();
+}
+void ManagedSession::confirmProbe(quint64 sequence)
+{
+  { std::scoped_lock lock(m_mutex);
+    if (sequence != m_requestedProbe || m_revoked || m_stopping) return;
+    m_completedProbe = sequence;
+  }
+  m_probeCondition.notify_all();
+}
+void ManagedSession::probeEventLoop()
+{
+  if (!m_probe) return;
+  quint64 sequence = 0;
+  { std::scoped_lock lock(m_mutex); sequence = ++m_requestedProbe; }
+  m_probe(sequence);
+  bool lost = false;
+  { std::unique_lock lock(m_mutex);
+    m_probeCondition.wait_for(lock, std::chrono::milliseconds(750), [this, sequence] {
+      return m_completedProbe == sequence || m_revoked || m_stopping;
+    });
+    const bool ready = m_completedProbe == sequence && !m_revoked && !m_stopping;
+    lost = m_loopReady && !ready && !m_revoked && !m_stopping;
+    m_loopReady = ready;
+    m_hadInput |= inputReadyLocked(); m_hadClipboard |= clipboardReadyLocked();
+  }
+  if (lost) revoke("event_loop_unresponsive");
+}
+void ManagedSession::notifyQuit()
+{
+  if (m_quit && QCoreApplication::instance())
+    QMetaObject::invokeMethod(QCoreApplication::instance(), m_quit, Qt::QueuedConnection);
+}
+void ManagedSession::revoke(const QString &reason)
+{
+  if (!m_active) return;
+  { std::scoped_lock lock(m_mutex); if (!m_revoked) { m_revoked = true; m_reason = reason; } }
+  m_probeCondition.notify_all();
+  notifyQuit();
+}
+void ManagedSession::graphics(const QString &backend)
+{
+  if (!m_active) return;
+  { std::scoped_lock lock(m_mutex); m_graphics = backend; }
+  if (backend == "wayland" && m_primary) revoke("wayland_primary_unsupported");
+}
+bool ManagedSession::inputReadyLocked() const
+{
+  if (m_revoked || (m_loopRequired && !m_loopReady)) return false;
+  if (m_graphics == "windows") return m_facts.value("windows_enabled") && m_facts.value("windows_hook") && m_facts.value("windows_desktop");
+  if (m_graphics == "x11") return m_facts.value("x11_enabled") && m_facts.value("x11_display") && m_facts.value("x11_xtest") && m_facts.value("x11_events");
+  if (m_graphics == "wayland") return !m_primary && m_facts.value("portal_started") && m_facts.value("portal_keyboard") && m_facts.value("portal_pointer")
+      && m_facts.value("eis_setup") && m_facts.value("eis_connected") && m_facts.value("eis_devices") && m_facts.value("eis_enabled");
+  return false;
+}
+bool ManagedSession::clipboardReadyLocked() const
+{
+  return !m_revoked && (!m_loopRequired || m_loopReady) && m_clipboard && m_facts.value("clipboard_provider")
+      && (m_graphics != "wayland" || m_facts.value("portal_clipboard"));
+}
+void ManagedSession::fact(const QString &name, bool value)
+{
+  if (!m_active) return;
+  bool lost = false;
+  { std::scoped_lock lock(m_mutex);
+    m_facts.insert(name, value);
+    const auto input = inputReadyLocked(), clipboard = clipboardReadyLocked();
+    lost = (m_hadInput && !input) || (m_clipboard && m_hadClipboard && !clipboard);
+    m_hadInput |= input; m_hadClipboard |= clipboard;
+  }
+  if (lost) revoke("graphical_backend_revoked");
+}
+bool ManagedSession::allowsPeer(const QString &screen, const QString &pin) const
+{
+  if (!m_active) return true;
+  std::scoped_lock lock(m_mutex);
+  const auto id = screen.startsWith("vincula-") ? screen.mid(8) : QString();
+  return !m_revoked && canonicalUuid(id) && m_expected.value(id) == pin && hexDigest(pin);
+}
+bool ManagedSession::allowsFingerprint(const QString &pin) const
+{
+  if (!m_active) return true;
+  std::scoped_lock lock(m_mutex);
+  return !m_revoked && hexDigest(pin) && m_expected.values().contains(pin);
+}
+bool ManagedSession::peerReady(const QString &screen, const QString &pin)
+{
+  if (!m_active) return true;
+  if (!allowsPeer(screen, pin)) return false;
+  std::scoped_lock lock(m_mutex);
+  const auto id = screen.mid(8);
+  if (m_revoked || m_peers.contains(id)) return false;
+  m_peers.insert(id, pin); return true;
+}
+void ManagedSession::peerDisconnected(const QString &screen)
+{
+  if (!m_active) return;
+  bool adopted = false;
+  { std::scoped_lock lock(m_mutex); adopted = m_peers.remove(screen.mid(8)) > 0; }
+  if (adopted) revoke("authenticated_peer_disconnected");
+}
+QJsonObject ManagedSession::snapshot(const QString &challenge)
+{
+  require(hexDigest(challenge), "managed challenge is invalid");
+  std::scoped_lock lock(m_mutex);
+  require(++m_sequence <= 9007199254740991ULL, "managed sequence exhausted");
+  QJsonArray peers;
+  if (!m_revoked) for (auto it = m_peers.begin(); it != m_peers.end(); ++it)
+    peers.append(QJsonObject{{"node_id", it.key()}, {"pin_sha256", it.value()}, {"handshake", true}});
+  return {{"type", "snapshot"}, {"protocol", 1}, {"session_id", m_bootstrap.value("session_id")},
+          {"node_id", localNode()}, {"engine_nonce", m_bootstrap.value("engine_nonce")},
+          {"manifest_sha256", m_bootstrap.value("manifest_sha256")}, {"challenge", challenge},
+          {"sequence", qint64(m_sequence)}, {"revoked", m_revoked}, {"reason", m_reason},
+          {"role", m_primary ? "primary" : "client"}, {"input_ready", inputReadyLocked()},
+          {"clipboard_ready", clipboardReadyLocked()}, {"peers", peers}, {"local_pin_sha256", m_localPin}};
+}
+
+} // namespace deskflow
