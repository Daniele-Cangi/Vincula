+#ifdef Q_OS_WIN
+      DWORD available = 0, count = 0;
+      if (!PeekNamedPipe(reinterpret_cast<HANDLE>(outgoing[0]), nullptr, 0, nullptr, &available, nullptr)) throw std::runtime_error("fixture response closed");
+      if (elapsed.elapsed() > 2000) throw std::runtime_error("fixture response timeout");
+      if (!available) { QTest::qSleep(1); continue; }
+      const auto wanted = std::min<DWORD>(available, DWORD(size - offset));
+      if (!ReadFile(reinterpret_cast<HANDLE>(outgoing[0]), value.data() + offset, wanted, &count, nullptr) || !count) throw std::runtime_error("fixture response closed");
+#else
+      pollfd ready{int(outgoing[0]), POLLIN, 0};
+      if (poll(&ready, 1, 2000) != 1) throw std::runtime_error("fixture response timeout");
+      const auto count = read(int(outgoing[0]), value.data() + offset, size_t(size - offset));
+      if (count <= 0) throw std::runtime_error("fixture response closed");
+#endif
+      offset += int(count);
+    }
+    return value;
+  }
+  QJsonObject receive() const
+  {
+    const auto header = receiveBytes(4); quint32 length = 0;
+    for (const auto byte : header) length = (length << 8) | static_cast<unsigned char>(byte);
+    if (!length || length > 65536) throw std::runtime_error("fixture response oversized");
+    return ManagedSession::parseCanonical(receiveBytes(int(length)));
+  }
+};
+}
