+
+void ManagedSessionTests::privateControlRequiresLiveBackendLoop()
+{
+  PrivateChannelFixture channel; ManagedSession s;
+  channel.send(channel.enrollment()); QVERIFY(s.initialize(channel.arguments()));
+  std::atomic<bool> acknowledge{false}; bool stopped = false;
+  s.startControl([&stopped] { stopped = true; }, [&s, &acknowledge](quint64 sequence) {
+    if (acknowledge) s.confirmProbe(sequence);
+  });
+  windowsReady(s); s.fact("clipboard_provider", true);
+  const QJsonObject request{{"type", "snapshot"}, {"challenge", QString(64, '7')}};
+  channel.send(request); const auto pending = channel.receive();
+  QVERIFY(!pending["input_ready"].toBool()); QVERIFY(!pending["revoked"].toBool());
+  acknowledge = true;
+  channel.send(request); const auto ready = channel.receive();
+  QVERIFY(ready["input_ready"].toBool()); QVERIFY(ready["clipboard_ready"].toBool());
+  acknowledge = false;
+  channel.send(request); const auto lost = channel.receive();
+  QVERIFY(lost["revoked"].toBool()); QVERIFY(!lost["input_ready"].toBool());
+  QCOMPARE(lost["reason"].toString(), "event_loop_unresponsive");
+  QTRY_VERIFY_WITH_TIMEOUT(stopped, 2000); s.shutdown();
+}
