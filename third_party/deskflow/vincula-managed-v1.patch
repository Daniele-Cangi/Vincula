+void ManagedSessionTests::privateControlBindsChallengeAndStops()
+{
+  PrivateChannelFixture channel; ManagedSession s;
+  channel.send(channel.enrollment()); QVERIFY(s.initialize(channel.arguments()));
+  bool stopped = false; s.startControl([&stopped] { stopped = true; });
+  const QString challenge(64, '5');
+  channel.send(QJsonObject{{"type", "snapshot"}, {"challenge", challenge}});
+  const auto response = channel.receive();
+  QCOMPARE(response["challenge"].toString(), challenge);
+  QCOMPARE(response["engine_nonce"].toString(), QString(64, 'd'));
+  QCOMPARE(response["sequence"].toInteger(), 1);
+  QVERIFY(!response["input_ready"].toBool()); QVERIFY(!response["clipboard_ready"].toBool());
+  channel.send(QJsonObject{{"type", "stop"}});
+  QTRY_VERIFY_WITH_TIMEOUT(stopped, 2000);
+  QCOMPARE(state(s)["reason"].toString(), "owner_stop"); s.shutdown();
+  channel.send(channel.enrollment()); ManagedSession repeated;
+  QVERIFY_EXCEPTION_THROWN(repeated.initialize(channel.arguments()), std::runtime_error);
+}
