+
+namespace deskflow {
+
+// Owner-local session facts. No clipboard contents, input probes or global IPC.
+class ManagedSession
+{
+public:
+  ManagedSession() = default;
+  ~ManagedSession();
+  ManagedSession(const ManagedSession &) = delete;
+  ManagedSession &operator=(const ManagedSession &) = delete;
+  static ManagedSession &instance();
+
+  static QJsonObject parseCanonical(const QByteArray &raw);
+  static void validateBootstrap(const QJsonObject &object);
+  static bool canonicalUuid(const QString &value);
+  static bool hexDigest(const QString &value);
+  static void privateDirectory(const QString &path);
+  static int provision(const QString &directory, const QString &session, const QString &node);
+  static QString certificateFingerprint(const QString &path);
+
+  void load(const QJsonObject &object); // pure state initialization; also used by unit tests
+  bool initialize(const QStringList &arguments);
+  bool active() const { return m_active; }
+  bool primary() const { return m_primary; }
+  bool clipboardRequested() const { return m_clipboard; }
+  QString settingsFile() const { return m_bootstrap.value("settings_file").toString(); }
+  QString stateFile() const { return m_bootstrap.value("state_file").toString(); }
+  QString profileRoot() const;
+  QString certificateFile() const;
+  QString localNode() const { return m_bootstrap.value("node_id").toString(); }
+  QString primaryNode() const { return m_bootstrap.value("primary").toString(); }
+
+  void startControl(std::function<void()> quit, std::function<void(quint64)> probe = {});
+  void confirmProbe(quint64 sequence);
+  void shutdown();
+  void graphics(const QString &backend);
+  void fact(const QString &name, bool value);
+  bool allowsPeer(const QString &screenName, const QString &fingerprint) const;
+  bool allowsFingerprint(const QString &fingerprint) const;
+  bool peerReady(const QString &screenName, const QString &fingerprint);
+  void peerDisconnected(const QString &screenName);
+  void revoke(const QString &reason);
+  QJsonObject snapshot(const QString &challenge);
+
+private:
+  bool inputReadyLocked() const;
+  bool clipboardReadyLocked() const;
+  void notifyQuit();
+  void control();
+  QByteArray readFrame(int timeoutMs);
+  void writeFrame(const QJsonObject &object);
+  bool readExact(char *data, qsizetype size, int timeoutMs);
+  void validateFiles();
+  void probeEventLoop();
+
+  bool m_active = false;
+  bool m_primary = false;
+  bool m_clipboard = false;
+  QJsonObject m_bootstrap;
+  QMap<QString, QString> m_expected;
+  QMap<QString, QString> m_peers;
+  QMap<QString, bool> m_facts;
+  QString m_graphics;
+  QString m_localPin;
+  QString m_reason;
+  bool m_revoked = false;
+  bool m_hadInput = false;
+  bool m_hadClipboard = false;
+  quint64 m_sequence = 0;
+  qintptr m_in = -1;
+  qintptr m_out = -1;
+  std::atomic<bool> m_stopping{false};
+  std::thread m_thread;
+  std::function<void()> m_quit;
+  std::function<void(quint64)> m_probe;
+  std::condition_variable m_probeCondition;
+  quint64 m_requestedProbe = 0;
+  quint64 m_completedProbe = 0;
+  bool m_loopRequired = false;
+  bool m_loopReady = false;
+  mutable std::mutex m_mutex;
+};
+
+} // namespace deskflow
